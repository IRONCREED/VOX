{
	"name": "ironcreed-credo",
	"version": "1.8.0",
	"private": true,
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
		"build": "bash scripts/build-public.sh",
		"start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
		"brand:generate": "node scripts/render-brand-asset.mjs --write",
		"brand:check": "node scripts/render-brand-asset.mjs --check",
		"sitemaps:build": "node scripts/sitemaps.mjs --write",
		"sitemaps:check": "node scripts/sitemaps.mjs --check",
		"format": "prettier --write . --ignore-path .prettierignore",
		"format:check": "prettier --check . --ignore-path .prettierignore",
		"lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
		"lint:styles": "stylelint \"app/**/*.css\" \"src/**/*.css\"",
		"typecheck": "tsc --noEmit",
		"test:source": "node --test tests/source/*.test.mjs",
		"test:rendered": "node --test tests/rendered-html.test.mjs",
		"guard:integrity": "node constitutional-guard/run.mjs integrity",
		"test": "npm run test:source && npm run build && npm run test:rendered",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run lint:styles && npm run brand:check && npm run sitemaps:check && npm run guard:integrity && npm run test",
		"validate:artifact": "bash scripts/validate-artifact.sh"
	},
	"dependencies": {
		"next": "16.2.6",
		"react": "19.2.6",
		"react-dom": "19.2.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.37.1",
		"@tailwindcss/postcss": "4.2.1",
		"@types/node": "22.19.19",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"@vitejs/plugin-rsc": "0.5.26",
		"eslint": "9.39.4",
		"eslint-config-next": "16.2.6",
		"prettier": "3.6.2",
		"react-server-dom-webpack": "19.2.6",
		"stylelint": "16.23.1",
		"tailwindcss": "4.2.1",
		"typescript": "5.9.3",
		"vinext": "0.0.50",
		"vite": "8.0.13",
		"wrangler": "4.92.0"
	},
	"type": "module",
	"displayName": "IRONCREED — Кредо"
}
